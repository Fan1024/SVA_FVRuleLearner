// Analyzed file list for tasks/l15_l2_mshr_onehot.
//
// Read by two consumers, which is why one list holds every source:
//   * lists/tc_elab.tcl:  analyze -sv12 -f lists/tc_elab.files
//   * taskdefs.slang_args, which filters it into tc_elab.files.slang
//     for the design map.
// v5/round.py appends one `../submission/<web>.sv` line per worker at
// the end, so ORDER MATTERS: the RTL comes first because it carries
// the `include of l2.tmp.h / l15.tmp.h whose macros the checker and
// the FT then use, and a worker's file must come last so it can
// reference anything above it.
//
// Paths are relative to the package root -- the drivers `cd $task_root`
// before sourcing tc_elab.tcl.

+incdir+rtl/openpiton_l15l2

// USE_GENERIC_SRAM_IMPLEMENTATION suppresses `SYNTHESIZABLE_BRAM inside
// the generated define.tmp.h, so every sram_* wrapper takes its
// behavioural array model. OpenPiton does not ship bram_1rw_wrapper in
// the L1.5/L2 filelists, so the package would otherwise name a module it
// does not contain.
+define+USE_GENERIC_SRAM_IMPLEMENTATION

