// Analyzed file list for nvdla_cdp_syncfifo_order. Paths are relative to the
// PACKAGE ROOT: the elaboration recipe is sourced with the package root as cwd
// and `slang` is run from there too, so one spelling serves both.
//
// The round appends one `../submission/<worker>.sv` line per worker to the end
// of this file (v5/round.py), which resolves to <run_root>/submission from the
// same cwd. Do not add a trailing `-y`/library directive after the file list --
// an appended source line has to stay a source line.
//
// One `analyze -sv12` covers the whole list, which is what the upstream task
// did too: the generated NVDLA RTL is Verilog-2001 but declares no identifier
// that SystemVerilog-2012 reserves.
+incdir+include

// `SYNTHESIS` selects the synthesizable branch of the generated RTL and drops
// the `simulate_x_tick.vh` X-injection tasks; `VLIB_BYPASS_POWER_CG` makes
// NV_CLK_gate_power a wire-through instead of a latch-based gate. Both come
// from the upstream task's own analyze line.
+define+SYNTHESIS
+define+VLIB_BYPASS_POWER_CG

// --- the three RAM models and the clock gate --------------------------------
// nvdla_cdp_formal_ram.sv is the task's functional replacement for the
// nv_ram_rwsthp_80x15 / 80x72 / 60x168 foundry wrappers; NV_CLK_gate_power.v
// is upstream vlib.
rtl/nvdla_cdp_formal_ram.sv
rtl/NV_CLK_gate_power.v

// --- the CDP synchronization FIFO, byte-identical upstream RTL --------------
rtl/NV_NVDLA_CDP_DP_syncfifo.v

// --- the oracle and the formal top ------------------------------------------
sva/nvdla_cdp_syncfifo_order_checker.sv
ft/nvdla_cdp_syncfifo_order_ft.sv

// ---- phase-1 candidate targets ----------------------------------------
// LAST, because it is a `bind` into nvdla_cdp_syncfifo_order_ft and a bind
// must be analyzed after the module it binds into.
sva/targets_nvdla_cdp_syncfifo_order.sv
