wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_39,,T_BOUNDRSP_SR_DRAINS_UNDER_READY: assert property (@(posedge clock) disable iff (reset) (m_rdy && !push_w && !push_aw)[*N_DRAIN] |-> !cur_match);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
