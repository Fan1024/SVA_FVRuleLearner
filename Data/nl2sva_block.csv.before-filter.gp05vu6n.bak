wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_41,,T_DEADLOCK_W_PORT_BLOCKED_ONLY_BY_MISSING_ID: assert property (@(posedge clock) disable iff (reset) (m_rdy && !w_rdy && !push_aw)[*N_WBLOCK] |-> blocked);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_42,,T_RESET_SHIFT_REGISTER_EMPTY: assert property (@(posedge clock) disable iff (reset) $fell(reset) |-> ((sr_valid == 16'd0) && !m_val));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
