wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_17,,"T_CONSERV_SR_FILL_TRACKS_HANDSHAKES: assert property (@(posedge clock) disable iff (reset) 1'b1 |=> (sr_fill == ($past(sr_fill) + {7'd0, $past(push_w)} - {7'd0, $past(rd_beat)})));",Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_18,,T_CONSERV_AWFIFO_FILL_TRACKS_PTRS: assert property (@(posedge clock) disable iff (reset) (awf_fill == (awf_wr - awf_rd)));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_19,,"T_CONSERV_AWFIFO_FILL_TRACKS_HANDSHAKES: assert property (@(posedge clock) disable iff (reset) 1'b1 |=> (awf_fill == ($past(awf_fill) + {3'd0, $past(push_aw)} - {3'd0, $past(awf_pop)})));",Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_20,,T_CONSERV_AW_POP_COINCIDES_WITH_LAST_BEAT: assert property (@(posedge clock) disable iff (reset) (cid_valid && rd_awid) |=> (m_val && m_lst));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_21,,T_MUTEX_SR_VALID_IS_CONTIGUOUS: assert property (@(posedge clock) disable iff (reset) ((sr_valid & (sr_valid + 16'd1)) == 16'd0));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_22,,T_MUTEX_SR_ADVANCE_WITHIN_VALID: assert property (@(posedge clock) disable iff (reset) ((sr_adv & ~sr_valid) == 16'd0));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_23,,T_MUTEX_SR_ADVANCE_IS_UPWARD_CLOSED: assert property (@(posedge clock) disable iff (reset) (((sr_adv << 1) & sr_valid & ~sr_adv) == 16'd0));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_24,,T_MUTEX_SR_ADVANCE_IDLE_WITHOUT_READ: assert property (@(posedge clock) disable iff (reset) !rd_beat |-> (sr_adv == 16'd0));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_25,,T_MUTEX_SR_ADVANCE_NONEMPTY_ON_READ: assert property (@(posedge clock) disable iff (reset) rd_beat |-> (sr_adv != 16'd0));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_26,,T_BOUND_AWFIFO_FILL_LE_EIGHT: assert property (@(posedge clock) disable iff (reset) (awf_fill <= 4'd8));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_27,,T_BOUND_AWFIFO_EMPTY_IFF_FILL_ZERO: assert property (@(posedge clock) disable iff (reset) (awf_empty == (awf_fill == 4'd0)));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_28,,T_ALLOC_NO_W_ACCEPT_WHEN_SR_FULL: assert property (@(posedge clock) disable iff (reset) (sr_valid == 16'hffff) |-> !push_w);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_29,,T_ALLOC_NO_AW_ACCEPT_WHEN_FIFO_FULL: assert property (@(posedge clock) disable iff (reset) awf_full |-> !push_aw);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_30,,T_ALLOC_WRITE_LANDS_AT_THE_TOP_OF_THE_RUN: assert property (@(posedge clock) disable iff (reset) push_w |-> (sr_wrt == (rd_beat ? ((sr_valid + 16'd1) >> 1) : (sr_valid + 16'd1))));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_31,,T_REQRSP_OUT_BEAT_WITHOUT_CID_IS_LAST: assert property (@(posedge clock) disable iff (reset) (m_val && !cid_valid) |-> m_lst);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_32,,T_REQRSP_CID_RELOADS_WHEN_AW_QUEUED: assert property (@(posedge clock) disable iff (reset) (!cid_valid && !awf_empty && out_free) |=> cid_valid);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_33,,T_REQRSP_CID_STAYS_CLEAR_WHEN_AW_QUEUE_EMPTY: assert property (@(posedge clock) disable iff (reset) (!cid_valid && awf_empty) |=> !cid_valid);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_34,,T_PROTO_OUT_VALID_NOT_WITHDRAWN: assert property (@(posedge clock) disable iff (reset) (m_val && !m_rdy) |=> m_val);,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_35,,T_PROTO_OUT_PAYLOAD_STABLE: assert property (@(posedge clock) disable iff (reset) (m_val && !m_rdy) |=> ($stable(m_dat) && $stable(m_stb) && $stable(m_lst) && $stable(m_id)));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_36,,T_PROTO_W_PORT_REFUSES_ONLY_WHEN_SR_FULL: assert property (@(posedge clock) disable iff (reset) !w_rdy |-> (sr_valid == 16'hffff));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
wb2axip_axi3_reorder_oraclefree,wb2axip_axi3_reorder_oraclefree_37,,T_PROTO_AW_PORT_REFUSES_ONLY_WHEN_FIFO_FULL: assert property (@(posedge clock) disable iff (reset) !aw_rdy |-> (awf_fill == 4'd8));,Data/wb2axip_axi3_reorder_oraclefree/ft/tb.sv,
